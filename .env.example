# Copy to .env and fill in. Testnets only: NEVER put mainnet keys here.

# ── Hedera (the default chain) ──────────────────────────────────────────────
# Payout account: every Hedera-settled payment lands here (0.0.x, must exist).
WALLET=0.0.xxxxxxx

# The BUYER wallet: signs payments for the web app's test buyer, the MCP server,
# `mx402 analyst` and `npm run test:live`. A funded Hedera testnet account.
BUYER_ACCOUNT_ID=0.0.xxxxxxx
BUYER_PRIVATE_KEY=302e...            # DER (302e…/3030…) or raw hex
# HEDERA_KEY_TYPE=ecdsa              # only for raw-hex keys: ecdsa (default) | ed25519
# BUYER_MAX_PER_CALL=0.05            # the MCP/test buyer refuses to sign above this
# BUYER_BUDGET=1 HBAR                # per session

# The OPERATOR account (optional): writes one HCS receipt per settled call,
# lazy-creates accounts, spends Metered Tabs. Not in the per-call payment path.
HEDERA_ACCOUNT_ID=
HEDERA_PRIVATE_KEY=
HEDERA_TOPIC_ID=                     # keep one receipt topic across restarts

# ── Base Sepolia and Solana devnet (USDC) ────────────────────────────────────
# `npx tsx scripts/new-chain-wallets.ts` fills these in (keys are never printed).
# Fund the BUYER addresses with testnet USDC at https://faucet.circle.com.
# On Solana, send the seller a little USDC once too, so its token account exists.
BUYER_EVM_PRIVATE_KEY=
BUYER_EVM_ADDRESS=
SELLER_EVM_PRIVATE_KEY=
WALLET_EVM=                          # payout for EVM lanes (dex-pools-base)
BUYER_SOLANA_SECRET_KEY=             # base58, 64 bytes
BUYER_SOLANA_ADDRESS=
SELLER_SOLANA_SECRET_KEY=
WALLET_SOLANA=                       # payout for Solana lanes (weather-solana)
# EVM_RPC_URL=https://sepolia.base.org          # used to verify EVM settlements
# SOLANA_RPC_URL=https://api.devnet.solana.com  # used to verify Solana settlements

# ── Upstream APIs for lanes.json (a lane whose key is missing is skipped) ────
GROQ_API_KEY=                        # the llm lane (OpenAI-compatible, openai/gpt-oss-20b)
# LLM_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-20b
GRAPH_API_KEY=                       # The Graph: a query key from Subgraph Studio (dex-pools, lending-markets, subgraph-gateway, uniswap-data)
UNISWAP_API_KEY=                     # Uniswap Trading API (uniswap-quote, swap builder)
ETHERSCAN_API_KEY=                   # the etherscan lane
TALLY_API_KEY=
ALPHAVANTAGE_KEY=
# MX_GRAPH_PORT=4130                 # where src/graph/server.ts listens
# GRAPH_GATEWAY=https://gateway.thegraph.com

# Override the Hedera facilitator (default: blocky402 on testnet)
# FACILITATOR_URL=https://api.testnet.blocky402.com

# ── World ID 4.0 (optional): human vs agent pricing ──────────────────────────
# Unset = simulated sessions (signed, labelled "simulated" everywhere).
WORLD_RP_ID=
WORLD_APP_ID=
WORLD_ACTION=x402-verify
WORLD_RP_SIGNING_KEY=
WORLD_TOKEN_SECRET=                  # REQUIRED in production: `openssl rand -hex 32`
