# copy to .env and fill in: testnet only, NEVER mainnet keys

# Payout account: every metered payment settles here (Hedera 0.0.x, must exist).
WALLET=0.0.xxxxxxx

# The BUYER wallet: signs payments for the dashboard's test buyer, the MCP
# server and `npm run test:live`. A funded Hedera testnet account.
BUYER_ACCOUNT_ID=0.0.xxxxxxx
BUYER_PRIVATE_KEY=302e...            # DER (302e…/3030…) or raw hex
# HEDERA_KEY_TYPE=ecdsa              # only for raw-hex keys: ecdsa (default) | ed25519
# BUYER_MAX_PER_CALL=0.05            # HBAR: the MCP/test buyer refuses to sign above this
# BUYER_BUDGET=1                     # HBAR per session

# The OPERATOR account (optional): writes one HCS receipt per settled call and
# lazy-creates Hedera accounts for connected 0x wallets. Not in the payment path.
HEDERA_ACCOUNT_ID=
HEDERA_PRIVATE_KEY=
# keep one receipt topic across restarts (the hub prints one on first run)
HEDERA_TOPIC_ID=

# Upstreams for lanes.json. A lane whose required key is missing is skipped.
LLM_URL=http://localhost:11434       # Ollama (OpenAI-compatible /v1/chat/completions), or https://api.openai.com
LLM_MODEL=llama3.2
LLM_API_KEY=                         # optional (Ollama needs none)
GRAPH_API_KEY=                       # The Graph (Uniswap v3 subgraph)
TALLY_API_KEY=
ETHERSCAN_KEY=
ALPHAVANTAGE_KEY=

# Override the facilitator (default: blocky402 on Hedera testnet)
# FACILITATOR_URL=https://api.testnet.blocky402.com

# World ID 4.0: human vs agent pricing. Unset = SIMULATED sessions (signed,
# labelled "simulated" everywhere).
WORLD_RP_ID=
WORLD_APP_ID=
WORLD_ACTION=x402-verify
WORLD_RP_SIGNING_KEY=
WORLD_TOKEN_SECRET=                  # REQUIRED in production: `openssl rand -hex 32`
