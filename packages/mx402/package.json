  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "x402",
    "hedera",
    "metered",
    "usage-based",
    "pay-per-token",
    "api",
    "monetization",
    "agents",
    "micropayments",
    "a2a",
    "mcp",
    "registry",
    "reputation"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clatsonhacks/meterx402.git"
  },
  "scripts": {
    "prepublishOnly": "cd ../.. && node scripts/build-cli.mjs"
