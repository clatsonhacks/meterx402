{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo \"static site: public/ is prebuilt (landing built with npm run build:landing)\"",
  "buildCommand": "echo \"no build step\"",
  "outputDirectory": "public",
  "routes": [
    { "src": "^/landing/assets/(.*)$", "headers": { "Cache-Control": "public, max-age=31536000, immutable" }, "continue": true },
    { "src": "^/$", "dest": "/landing/index.html" },
    { "src": "^/app/?$", "dest": "/index.html" }
  ]
}
